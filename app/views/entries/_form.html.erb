<div class="container pb-2">
  <%= simple_form_for(@entry, html: {
        'data-turbo' => false,
        data: {
          controller: 'form-submission',
          action: 'submit->form-submission#showLoading'
        }
      }) do |f| %>
    <%= f.error_notification %>
    <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

    <div class="form-inputs">
      <%= f.input :title,
                  hint: safe_join([
                    'The title of your entry can not be longer than 250 characters.',
                    tag(:br),
                    content_tag(:small, class: 'text-muted') do
                      safe_join([
                        'Characters: ',
                        content_tag(:span, '0', data: { character_counter_target: 'counter' }),
                        ' / 250'
                      ])
                    end
                  ]),
                  input_html: {
                    data: {
                      character_counter_target: 'input',
                      action: 'input->character-counter#updateCounter'
                    }
                  },
                  wrapper_html: {
                    data: {
                      controller: 'character-counter',
                      character_counter_maximum_value: 250
                    }
                  } %>

      <%= f.hidden_field :disqualified, value: false %>
      <%= f.hidden_field :contest_instance_id, value: @entry.contest_instance_id %>
      <%= f.hidden_field :profile_id, value: @entry.profile_id %>

      <%= f.association :category, collection: @entry.contest_instance.categories, label_method: :kind %>
      <%= f.input :entry_file,
                  as: :file,
                  required: true,
                  hint: 'Only PDF files under 30 MB are allowed.' %>

      <h3 class="mt-4">Confirm Class Level</h3>
      <p class="small text-muted">
        Changing class level updates your profile and which contests you see on your dashboard.
      </p>
      <%= select_tag 'entry[confirmed_class_level_id]',
                     options_from_collection_for_select(ClassLevel.all, :id, :name, @confirmed_class_level_id || current_user.profile.class_level_id),
                     class: 'form-select', required: true %>

      <% if @effective_questions.any? %>
        <h3 class="mt-4">Additional Questions</h3>
        <% @effective_questions.each do |effective| %>
          <% question = effective.question %>
          <% class_level = ClassLevel.find_by(id: @confirmed_class_level_id) %>
          <% required = application_question_required_for_class_level?(effective, class_level) %>
          <% value = @prefill_values[question.id] %>
          <div class="mb-3">
            <% if question.system_key == 'accepted_financial_aid_notice' %>
              <% if (content = render_editable_content('profiles', 'finaid_information')) %>
                <strong>Important note for students receiving needs-based financial aid:</strong>
                <p>
                  <%= content %>
                  <br>
                  <%= link_to 'https://finaid.umich.edu', target: '_blank', class: 'link_to' do %>
                    Learn more about financial aid terms and conditions on the Office of Financial Aid's website
                    <i class="bi bi-box-arrow-up-right"></i>
                  <% end %>
                </p>
              <% end %>
            <% end %>

            <%= label_tag dom_id(question, :answer), question.label, class: 'form-label' %>
            <% if required %><span class="text-danger">*</span><% end %>
            <% if question.help_text.present? %>
              <div class="form-text mb-1"><%= question.help_text %></div>
            <% end %>

            <% if question.field_type == 'boolean' %>
              <div class="form-check">
                <%= render_application_question_field(
                      nil,
                      question: question,
                      name: "entry_answers[#{question.id}]",
                      value: value,
                      required: required
                    ) %>
                <%= label_tag dom_id(question, :answer), question.label, class: 'form-check-label' %>
              </div>
            <% else %>
              <%= render_application_question_field(
                    nil,
                    question: question,
                    name: "entry_answers[#{question.id}]",
                    value: value,
                    required: required
                  ) %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="d-flex justify-content-center mt-3 d-none" data-form-submission-target="loading">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Uploading file, please wait...</span>
      </div>
    </div>

    <div class="form-actions">
      <%= f.button :submit, 'Submit Entry', class: 'btn btn-primary', data: { 'form-submission-target' => 'submitButton' } %>
      <%= link_to 'Cancel', applicant_dashboard_path, class: 'text-danger link_to' %>
    </div>
  <% end %>
</div>
