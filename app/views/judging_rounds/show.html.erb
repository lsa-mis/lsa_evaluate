<div class="container" data-controller="judging-round-show">
  <h1>Review Rankings for Round <%= @judging_round.round_number %></h1>

  <div class="card mt-4">
    <div class="card-header">
      <h3>Entry Rankings</h3>
    </div>
    <div class="card-body">
      <%= render 'judging_results/rankings_table',
            round: @judging_round,
            container: @container,
            contest_description: @contest_description,
            contest_instance: @contest_instance,
            show_next_round_column: @judging_round.round_number < @contest_instance.judging_rounds.count,
            link_entry_details: false,
            sort_context: :judging_round %>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to 'Back to Manage Judging',
        container_contest_description_contest_instance_judging_assignments_path(
          @container, @contest_description, @contest_instance
        ),
        class: 'btn btn-secondary' %>
  </div>
</div>
