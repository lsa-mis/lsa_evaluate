
<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= button_to "Sign in with U-M account", omniauth_authorize_path(resource_name, provider),
                  params: saml_authorize_params,
                  class: "btn btn-warning btn-sm mb-4",
                  data: { turbo: false } %><br />
  <% end %>
<% end %>

<% if dev_browser_login_allowed? %>
  <%= link_to 'Local browser login', dev_sessions_path, class: 'btn btn-outline-secondary btn-sm mb-4' %>
<% end %>
