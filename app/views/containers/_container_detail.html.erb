<!-- app/views/containers/_container_detail.html.erb -->
<div id="<%= dom_id(container) %>" class="container" data-controller="modal">
  <div data-modal-target="mainContent">
    <div class="container-header mb-4">
      <h1 class="mb-3"><%= container.name %></h1>

      <% show_configure = policy(@container).update? ||
                          policy(@container).access_contest_instances? ||
                          policy(@container).manage_judging? %>
      <% show_review = policy(@container).applicants? ||
                       policy(@container).reports? ||
                       policy(@container).winners? %>

      <% if show_configure || show_review %>
        <div class="row g-3 mb-3">
          <% if show_configure %>
            <div class="<%= show_review ? 'col-lg-7' : 'col-12' %>">
              <section class="border rounded p-3 h-100"
                       aria-labelledby="collection-configuration-heading">
                <h2 id="collection-configuration-heading" class="h6 text-uppercase text-muted mb-2">
                  Configure collection
                </h2>
                <p class="small text-muted mb-3">
                  Set up questions, categories, awards, and collection-wide contest settings.
                </p>
                <nav class="d-flex flex-wrap gap-2" aria-label="Configure collection">
                  <% if policy(@container).update? %>
                    <%= link_to container_application_questions_path(@container),
                                class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Application Questions
                    <% end %>
                    <%= link_to container_categories_path(@container),
                                class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="bi bi-tags me-1" aria-hidden="true"></i> Categories
                    <% end %>
                    <%= link_to container_awards_path(@container),
                                class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="bi bi-trophy me-1" aria-hidden="true"></i> Awards
                    <% end %>
                  <% end %>

                  <% if policy(@container).access_contest_instances? %>
                    <%= link_to new_container_bulk_contest_instance_activation_path(@container),
                                class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="bi bi-toggle-on me-1" aria-hidden="true"></i> Bulk Activate Contest Instances
                    <% end %>
                  <% end %>

                  <% if policy(@container).manage_judging? %>
                    <%= link_to new_container_bulk_judging_window_path(@container),
                                class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="bi bi-calendar-range me-1" aria-hidden="true"></i> Bulk Update Judging Windows
                    <% end %>
                  <% end %>

                  <% if policy(@container).update? %>
                    <%= link_to edit_container_path(@container),
                                class: 'btn btn-sm btn-outline-primary' do %>
                      <i class="bi bi-pencil-square me-1" aria-hidden="true"></i> Edit Collection Settings
                    <% end %>
                  <% end %>
                </nav>
              </section>
            </div>
          <% end %>

          <% if show_review %>
            <div class="<%= show_configure ? 'col-lg-5' : 'col-12' %>">
              <section class="border rounded p-3 h-100 bg-light"
                       aria-labelledby="collection-activity-heading">
                <h2 id="collection-activity-heading" class="h6 text-uppercase text-muted mb-2">
                  Review activity
                </h2>
                <p class="small text-muted mb-3">
                  See applicants, reports, and winners from this collection.
                </p>
                <nav class="d-flex flex-wrap gap-2" aria-label="Review activity">
                  <% if policy(@container).applicants? %>
                    <%= link_to container_applicants_path(@container),
                                class: 'btn btn-sm btn-outline-secondary' do %>
                      <i class="bi bi-people me-1" aria-hidden="true"></i> Applicants
                    <% end %>
                  <% end %>

                  <% if policy(@container).reports? %>
                    <%= link_to reports_container_path(@container),
                                class: 'btn btn-sm btn-outline-secondary' do %>
                      <i class="bi bi-download me-1" aria-hidden="true"></i> Generate Reports
                    <% end %>
                  <% end %>

                  <% if policy(@container).winners? %>
                    <%= link_to winners_container_path(@container),
                                class: 'btn btn-sm btn-outline-secondary' do %>
                      <i class="bi bi-award me-1" aria-hidden="true"></i> Winners
                    <% end %>
                  <% end %>
                </nav>
              </section>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="container-info">
        <div class="mb-3">
          <%= render_description(container) %>
        </div>
        <div class="mb-3">
          <div class="text-muted small">Department</div>
          <p class="mb-0 fw-bold"><%= container.department.name %></p>
        </div>
        <div class="mb-3">
          <div class="text-muted small">Visibility</div>
          <p class="mb-0 fw-bold"><%= container.visibility.kind %></p>
        </div>
        <div class="mb-3">
          <%= render 'assigned_users_summary', assignments: container.collection_staff_assignments %>
        </div>
      </div>
    </div>

    <%= render 'entries_summary', container: @container %>

    <hr>
    <%= render 'section_help_accordion',
               heading: "#{container.name} Contests",
               help_text: 'Summary of contests within this collection',
               collapse_id: 'contests-in-collection-help' %>

    <div data-controller="filter">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div class="form-check mb-0">
          <input class="form-check-input"
                 type="checkbox"
                 id="statusFilter"
                 checked
                 data-action="change->filter#toggleFilter"
                 data-filter-target="statusFilter">
          <label class="form-check-label" for="statusFilter">
            Show only <span class="fw-bolder">Active</span> contest descriptions
          </label>
        </div>

        <button type="button"
                class="btn btn-sm btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#create-contest-choice-modal">
          Create New Contest
        </button>
      </div>

      <div class="mb-3">
        This collection has <span class="fw-bolder small"><%= pluralize(container_contest_descriptions.active.count, "active description") %></span>
        and <span class="fw-bolder small"><%= pluralize(container_contest_descriptions.count - container_contest_descriptions.active.count, "inactive description") %></span>.
      </div>

      <div class="container w-100 mx-auto">
        <% if container_contest_descriptions.present? %>
          <%= render 'contest_descriptions_table',
                    container: container,
                    descriptions: container_contest_descriptions %>
        <% else %>
          <div><p>No contest descriptions found.</p></div>
        <% end %>
      </div>
    </div>
  </div>

  <%= render 'create_contest_choice_modal', container: container %>
  <%= render 'shared/modal' %>
</div>
