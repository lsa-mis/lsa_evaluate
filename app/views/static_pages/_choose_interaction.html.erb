<div id="choose-interaction" class="my-4">
  <div class="row justify-content-center">
    <div id="student-submit-entry" class="col-12 col-md-10 col-lg-8 mb-4">
      <div class="card shadow-sm">
        <div class="card-body p-4 p-md-5">
          <% if (content = render_editable_content('home', 'submit_entry')) %>
              <%= content %>
          <% end %>

          <div>
            <% if current_user.profile_exists? %>
              <%= button_to 'View Dashboard', applicant_dashboard_path, method: :get, class: 'btn btn-primary' %>
            <% else %>
              <%= button_to 'Create Profile', new_profile_path, method: :get, class: 'btn btn-primary' %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if current_user.is_employee? || current_user.administrator? || current_user.manager? || current_user.axis_mundi? %>
    <div id="manage-submissions" class="text-center mb-4">
      <%= link_to 'Contest Administrators', containers_path, class: 'btn btn-outline-secondary' %>
    </div>
  <% end %>
</div>
