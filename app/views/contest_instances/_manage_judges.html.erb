<div id="<%= dom_id(contest_instance, :judges) %>">
  <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
      <h2 class="mb-1">Judging Rounds</h2>
      <p class="text-muted mb-0">
        <%= pluralize(contest_instance.actual_judging_rounds_count, 'round') %> configured for this contest instance.
      </p>
    </div>
    <% if policy(contest_instance).manage_judges? %>
      <%= link_to container_contest_description_contest_instance_judging_assignments_path(
            @container, @contest_description, contest_instance
          ),
          class: 'btn btn-primary' do %>
        <i class="bi bi-gear me-1"></i> Manage Judging
      <% end %>
    <% end %>
  </div>

  <div class="alert alert-info">
  <strong>All judging administration happens in Manage Judging.</strong>
  Use that page to add judges, assign them to rounds, set round dates, send instructions, and activate or complete rounds.
  </div>

  <% if contest_instance.judging_rounds.any? %>
    <div class="table-responsive">
      <table class="table table-sm align-middle">
        <thead>
          <tr>
            <th>Round</th>
            <th>Status</th>
            <th>Dates</th>
            <th>Judges</th>
            <th>Instructions</th>
          </tr>
        </thead>
        <tbody>
          <% contest_instance.judging_rounds.order(:round_number).each do |round| %>
            <% assignments = round.round_judge_assignments.active.includes(:user) %>
            <tr>
              <td>Round <%= round.round_number %></td>
              <td>
                <span class="badge bg-<%= round.completed? ? 'secondary' : (round.active? ? 'success' : 'warning') %>">
                  <%= round.completed? ? 'Completed' : (round.active? ? 'Active' : 'Pending') %>
                </span>
              </td>
              <td>
                <%= format_datetime(round.start_date) %>
                –
                <%= format_datetime(round.end_date) %>
              </td>
              <td>
                <% if assignments.any? %>
                  <%= pluralize(assignments.size, 'judge') %>
                <% else %>
                  <span class="text-muted">None assigned</span>
                <% end %>
              </td>
              <td>
                <% sent_count = assignments.count(&:instructions_sent_at) %>
                <% if assignments.empty? %>
                  <span class="text-muted">—</span>
                <% elsif sent_count == assignments.size %>
                  <span class="text-success">Sent to all</span>
                <% elsif sent_count.positive? %>
                  <span class="text-warning"><%= sent_count %> of <%= assignments.size %> sent</span>
                <% else %>
                  <span class="text-muted">Not sent</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-muted mb-0">No judging rounds have been created yet.</p>
  <% end %>
</div>
