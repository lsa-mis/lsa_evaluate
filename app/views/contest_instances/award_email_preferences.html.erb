<h1>Email Award Notices</h1>

<div class="card mb-4">
  <div class="card-header">
    <h2>Award notice options</h2>
  </div>
  <div class="card-body">
    <p class="mb-3">
      Send notices to applicants with an official winner or finalist status, or with assigned prizes.
      Payment shortcodes are not included in these emails.
    </p>

    <% if @award_notice_entries.any? %>
      <p class="fw-semibold"><%= pluralize(@award_notice_entries.size, 'recipient') %> will receive a notice:</p>
      <ul>
        <% @award_notice_entries.each do |entry| %>
          <li>
            <%= entry.profile.display_name %>
            — <%= entry.title %>
            <% if entry.award_status_label.present? %>
              (<%= entry.award_status_label %><%= ", #{entry.placement_label}" if entry.placement_label %>)
            <% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="alert alert-warning">
        No awarded entries yet. Assign a winner, finalist, or prize on the Awards tab first.
      </div>
    <% end %>

    <%= form_with url: send_award_notices_container_contest_description_contest_instance_path(
          @container,
          @contest_description,
          @contest_instance
        ),
        method: :post,
        class: 'email-preferences-form',
        data: {
          controller: 'confirm',
          confirm_message_value: 'Send award notices to the listed recipients?'
        } do |f| %>

      <div class="form-check mb-4">
        <%= f.check_box :include_amounts,
              id: 'include_amounts',
              class: 'form-check-input' %>
        <%= f.label :include_amounts, 'Include prize amounts', class: 'form-check-label' %>
        <div class="form-text">When checked, emails include dollar amounts. Shortcodes are never included.</div>
      </div>

      <div class="d-flex mt-4">
        <%= f.submit 'Send award notices',
                     class: 'btn btn-primary me-2',
                     disabled: @award_notice_entries.none? %>
        <%= link_to 'Cancel',
                    container_contest_description_contest_instance_path(
                      @container, @contest_description, @contest_instance, tab: 'awards'
                    ),
                    class: 'btn btn-secondary' %>
      </div>
    <% end %>
  </div>
</div>
