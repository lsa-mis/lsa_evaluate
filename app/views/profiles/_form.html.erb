<div class="container">
  <div class="row justify-content-start">
    <div class="col-12 col-md-8">
      <%= simple_form_for @profile, html: { data: { turbo: false } } do |f| %>
        <%= f.error_notification %>
        <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

        <div class="form-inputs">
          <h2 class="mt-4">Identity</h2>
          <div class="ms-4">
            <%= f.input :user_id, as: :hidden, input_html: { value: current_user.id } %>

            <div class="row">
              <div class="col">
                <%= f.input :legal_first_name,
                            label: 'Legal first name',
                            input_html: { value: @profile.legal_first_name.presence || current_user.first_name } %>
              </div>
              <div class="col">
                <%= f.input :legal_last_name,
                            label: 'Legal last name',
                            input_html: { value: @profile.legal_last_name.presence || current_user.last_name } %>
              </div>
            </div>

            <div class="row">
              <small class="fw-light">(Preferred name is optional and used for display labels when present.)</small>
            </div>
            <div class="row">
              <div class="col">
                <%= f.input :preferred_first_name, required: false %>
              </div>
              <div class="col">
                <%= f.input :preferred_last_name, required: false %>
              </div>
            </div>

            <div class="row">
              <div class="col">
                <% if action_name == 'new' || action_name == 'create' %>
                  <%= f.input :umid, label: 'UMID' %>
                <% end %>
              </div>
            </div>
          </div>

          <h2 class="mt-4">Class Level</h2>
          <div class="ms-4">
            <%= f.input :class_level_id,
                        collection: ClassLevel.all,
                        label_method: :name,
                        value_method: :id,
                        as: :radio_buttons,
                        label: 'Class Level',
                        wrapper: :vertical_collection_inline %>
          </div>
        </div>
        <div class="shadow p-3 mb-3 bg-body rounded" >
          <% if (content = render_editable_content('profiles', 'information')) %>
              <%= content %>
          <% end %>
        </div>
        <div class="form-actions pb-1">
          <%= f.button :submit, class: 'btn btn-primary' %>
          <%= link_to 'Cancel', applicant_dashboard_path, class: 'text-danger link_to' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
