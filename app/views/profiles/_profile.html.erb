<div id="<%= dom_id profile %>">
  <h1 class="mb-0"><%= profile.display_name %></h1>
  <div class="ms-2">
    <span class="text-body-tertiary"><small><em>Last updated: <%= profile.updated_at.strftime('%B %d, %Y') %></em></small></span><br>
    <span class="fw-light">UMID: <%= profile.umid %></span>
  </div>

  <div class="card mt-5">
    <div class="header card-header">
      <h2>Identity</h2>
    </div>
    <div class="card-body">
      <div class="ps-2">
        <p class="m-0">Email: <%= simple_format(profile.user.email, { class: 'fw-light' }) %></p>
        <p class="m-0">Legal name: <%= simple_format("#{profile.legal_first_name} #{profile.legal_last_name}", { class: 'fw-light' }) %></p>
        <% if profile.preferred_first_name.present? || profile.preferred_last_name.present? %>
          <p class="m-0">Preferred name: <%= simple_format([profile.preferred_first_name, profile.preferred_last_name].compact.join(' '), { class: 'fw-light' }) %></p>
        <% end %>
        <p class="m-0">Display name: <%= simple_format(profile.display_name, { class: 'fw-light' }) %></p>
        <p class="m-0">Class Level: <%= simple_format(profile.class_level&.name, { class: 'fw-light' }) %></p>
      </div>
    </div>
  </div>
</div>
