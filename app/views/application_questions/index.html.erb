<div class="d-flex justify-content-end">
  <div>
    <%= link_to 'Return to Manage Collection', container_path(@container), class: 'link_to text-nowrap' %>
  </div>
</div>

<h2 class="mt-4">Application Questions</h2>
<p class="text-muted">
  Manage the question library for this collection. Set default required/optional/off status here.
  Contests and contest instances can override these defaults.
  Drag the grip handle to change the question order.
</p>

<div class="mb-3">
  <%= link_to 'Add custom question', new_container_application_question_path(@container), class: 'btn btn-sm btn-primary' %>
</div>

<%= form_with url: update_requirements_container_application_questions_path(@container), method: :patch do %>
  <div class="table-responsive">
    <table class="table table-sm align-middle application-questions-table">
      <thead>
        <tr>
          <th class="text-muted" scope="col">
            <span class="visually-hidden">Reorder</span>
          </th>
          <th>Question</th>
          <th>Type</th>
          <th>Default status</th>
          <th></th>
        </tr>
      </thead>
      <tbody data-controller="application-question-sort"
             data-application-question-sort-url-value="<%= reorder_container_application_questions_path(@container) %>">
        <% @application_questions.each do |question| %>
          <% requirement = @container_requirements[question.id] %>
          <tr class="<%= 'table-secondary' unless question.active? %>"
              data-question-id="<%= question.id %>">
            <td class="align-middle pe-0">
              <span class="drag-handle"
                    title="Drag to reorder"
                    aria-label="Drag to reorder <%= question.label %>">
                <i class="bi bi-grip-vertical" aria-hidden="true"></i>
              </span>
            </td>
            <td>
              <strong><%= question.label %></strong>
              <% if question.help_text.present? %>
                <div class="small text-muted"><%= question.help_text %></div>
              <% end %>
            </td>
            <td><%= question.field_type_label %></td>
            <td>
              <%= select_tag "requirements[#{question.id}][status]",
                             options_for_select(question_status_options, requirement&.status || 'off'),
                             class: 'form-select form-select-sm' %>
            </td>
            <td class="text-nowrap">
              <%= link_to 'Edit', edit_container_application_question_path(@container, question), class: 'link_to' %>
              <% unless question.system? %>
                <%= button_to 'Delete', container_application_question_path(@container, question),
                              method: :delete,
                              class: 'btn btn-link btn-sm text-danger p-0 ms-2',
                              form: { data: { turbo_confirm: 'Delete this question?' } } %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= submit_tag 'Save default requirements', class: 'btn btn-primary mb-3' %>
<% end %>
